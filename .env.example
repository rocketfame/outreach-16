# OpenAI API key (default text provider and gpt-image-2 image generation)
OPENAI_API_KEY=sk-...
# Optional text models; defaults to gpt-5.5 for all text tasks.
# OPENAI_TEXT_MODEL=gpt-5.5
# OPENAI_SMALL_MODEL=gpt-5.5
# OPENAI_VISION_MODEL=gpt-5.5

# Optional external OpenAI-compatible text-provider override.
# TEXT_API_BASE_URL=https://your-text-provider.example/v1
# TEXT_API_KEY=your-text-provider-key
# TEXT_MODEL=your-article-model
# Optional: defaults to TEXT_MODEL
# TEXT_SMALL_MODEL=your-fast-classifier-model
# TEXT_VISION_MODEL=your-vision-capable-model
# TEXT_PROVIDER_NAME=self-hosted

# Automation API and shared article/cover worker pool
AUTOMATION_API_KEY=your-automation-bearer-token
# Optional: defaults to 3, capped at 8. Legacy alias: AUTOMATION_CONCURRENCY
GENERATION_CONCURRENCY=3
# Optional ETA estimate per article, in seconds. Defaults to 480.
GENERATION_AVG_JOB_SECONDS=480
# Hard ceiling across text, search, humanization, formatting, and image calls.
MAX_JOB_COST_USD=0.40
# Maximum application-level retries across the entire job.
MAX_RETRIES_PER_JOB=1
# Per AUTOMATION_API_KEY. Jobs reserve their full $0.40 cap before queueing.
DAILY_COST_LIMIT_USD=5.00
MONTHLY_COST_LIMIT_USD=100.00

# Tavily Search API Key (required for topic discovery)
TAVILY_API_KEY=tvly-...

# Undetectable.AI Humanizer API Key (required for Human Mode / humanizeOnWrite)
# Get key: https://undetectable.ai/ (Humanization API v2)
UNDETECTABLE_HUMANIZER_API_KEY=your-api-key

# Optional: Undetectable humanizer overrides
# UNDETECTABLE_HUMANIZER_BASE_URL=https://humanize.undetectable.ai
# UNDETECTABLE_HUMANIZER_MODEL=v11
# UNDETECTABLE_HUMANIZER_READABILITY=University
# UNDETECTABLE_HUMANIZER_PURPOSE=Article
# UNDETECTABLE_HUMANIZER_STRENGTH=Balanced
